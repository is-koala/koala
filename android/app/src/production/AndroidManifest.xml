<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".MainActivity">
            <!-- Production App Links yalnız kanonik web hostlarını ve uygulamanın
                 gerçekten karşılayabildiği yolları sahiplenir. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="iskoala.com" />
                <data android:host="www.iskoala.com" />
                <data android:pathPrefix="/hesap-dogrula" />
                <data android:pathPrefix="/sifre-belirle" />
                <data android:pathPrefix="/sifre-sifirla" />
                <data android:pathPrefix="/eposta-onayla" />
                <data android:pathPrefix="/payment/result" />
            </intent-filter>
        </activity>
    </application>
</manifest>
